<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show users</title>
</head>
<body>
  <a href="/user/new"><button>Add new user</button></a>
  <table border="1">
    <caption>User details</caption>
    <% for(user of results){ %>
      <tr>
        <td><%=user.ID%></td>
        <td><%=user.username%></td>
        <td><%=user.email%></td>
        <td><a href="/user/<%=user.ID%>/edit"><button>Edit</button></a></td>
        <td><a href="/user/<%=user.ID%>/delete"><button>Delete</button></a></td>
      </tr>
    <% } %>
  </table>
</body>
</html>